#Read files

taxa <- readTaxonData("data/taxa.tsv")

filenames <- v("data/cytb.nex", "data/cmos.nex" )
filemorpho <- v("data/Craneal_1_190.nex", "data/Body_191_302.nex","data/Limbs_303_355.nex" ) 

for (i in 1:2){
   datos[i] = readDiscreteCharacterData(filenames[i])
}


for (i in 1:3){
   morpho[i] = readDiscreteCharacterData(filemorpho[i])
}


datos[1].addMissingTaxa( taxa )
datos[2].addMissingTaxa( taxa )
morpho[1].addMissingTaxa( taxa )
morpho[2].addMissingTaxa( taxa )
morpho[3].addMissingTaxa( taxa )

###Some important Variables
n_taxa <- taxa.size()

#Initial vector to moves and monitors
mvi = 0
mni = 0

#analysis name
analysis_name = "ET"






# useful variables
n_species <- datos[1].ntaxa()
n_branches <- 2 * n_species - 3

########################################################################################################

#									Molecular Partitions

########################################################################################################


#### Sustituton Model

data[1] <- datos[1]
data[1].setCodonPartition( v(1,2) )

data[2] <- datos[1]
data[2].setCodonPartition( 3 )

data[3] <- datos[2]
data[3].setCodonPartition( v(1,2) )

data[4] <- datos[2]
data[4].setCodonPartition( 3 )

# how many partitions?
n_data_subsets <- 4

#### Sustituton Model
for (i in 1:n_data_subsets) {
  er_prior[i] <- v(1,1,1,1,1,1)
  er[i] ~ dnDirichlet(er_prior[i])
  moves[++mvi] = mvBetaSimplex(er[i], alpha=10, tune=true, weight=3)
}

for (i in 1:n_data_subsets) {
  pi_prior[i] <- v(1,1,1,1)
  pi[i] ~ dnDirichlet(pi_prior[i])
  moves[++mvi] = mvBetaSimplex(pi[i], alpha=10, tune=true, weight=2)
}


for (i in 1:n_data_subsets) {
  Q[i] := fnGTR(er[i],pi[i])
}



###### Heterogenity

for (i in 1:n_data_subsets) {
    alpha_prior_mean[i] <- ln(2.0)
    alpha_prior_sd[i] <- 0.587405
    alpha[i] ~ dnLognormal( alpha_prior_mean[i], alpha_prior_sd[i] )
    gamma_rates[i] := fnDiscretizeGamma( alpha[i], alpha[i], 4, false )
    moves[mvi++] = mvScale(alpha[i],lambda=0.1,weight=2)
}



######## Topology

out_group = clade("Sphenodon_punctatus")

# Prior distribution on the tree topology
topology ~ dnUniformTopology(taxa, outgroup=out_group)
moves[mvi++] = mvNNI(topology, weight=5.0)
moves[mvi++] = mvSPR(topology, weight=1.0)


######## Branch Lenght


# Branch length prior
for (i in 1:n_branches) {
    bl[i] ~ dnExponential(10.0)
    moves[mvi++] = mvScale(bl[i])
}

TL := sum(bl)


########## Creating tree model

psi := treeAssembly(topology, bl)


######## PHYLO MODEL

for (i in 1:n_data_subsets) {
  phyloSeq[i] ~ dnPhyloCTMC(tree=psi, Q=Q[i], siteRates=gamma_rates[i], branchRates=bl[i], type="DNA")
  phyloSeq[i].clamp(data[i])
}




########################################################################################################

#									Morphological Data

########################################################################################################
# how many partitions?
n_data_subsets <- 3

#### Sustituton Model


Q_morpho[1] := fnJC(9)
Q_morpho[2] := fnJC(8)
Q_morpho[3] := fnJC(4)



###### Heterogenity



for (i in 1:n_data_subsets) {
alpha_morpho ~ dnExponential( 1.0 )
rates_morpho[i] := fnDiscretizeGamma( alpha_morpho, alpha_morpho, 4 )
moves[mvi++] =mvScale(alpha_morpho, lambda=0.01, weight=5.0) 
moves[mvi++] =mvScale(alpha_morpho, lambda=0.1,  weight=3.0) 
moves[mvi++] =mvScale(alpha_morpho, lambda=1,    weight=1.0) 
}

########### Topology

psi


######## Branch Lenght

n_branches <- 2 * n_species - 2
clock_morpho ~ dnExponential(1.0)

moves[mvi++] =mvScale(clock_morpho, lambda=0.01, weight=4.0) 
moves[mvi++] =mvScale(clock_morpho, lambda=0.1,  weight=4.0) 
moves[mvi++] =mvScale(clock_morpho, lambda=1,    weight=4.0) 


######## PHYLO MODEL




  phyMorpho[1] ~ dnPhyloCTMC(tree=psi, siteRates=rates_morpho[1], branchRates=clock_morpho, Q=Q_morpho[1],type="Standard")
  phyMorpho[1].clamp(morpho[1])
  
  phyMorpho[2] ~ dnPhyloCTMC(tree=psi, siteRates=rates_morpho[2], branchRates=clock_morpho, Q=Q_morpho[2],type="Standard")
  phyMorpho[2].clamp(morpho[2])
  
   phyMorpho[3] ~ dnPhyloCTMC(tree=psi, siteRates=rates_morpho[3], branchRates=clock_morpho, Q=Q_morpho[3],type="Standard")
  phyMorpho[3].clamp(morpho[3])


######Our Model  


mymodel = model(Q)

###### define monitors
monitors[mni++] = mnModel(filename="output/Testudines_morphoBodypart.log",printgen=10, separator = TAB)
monitors[mni++] = mnFile(filename="output/Testudines_morphoBodypart.trees",printgen=10, separator = TAB, psi)

### Compute power posterior distributions
pow_p = powerPosterior(mymodel, moves, monitors, "output/pow_Testudines_morphoBodypart.out", cats=50, sampleFreq=10) 
pow_p.burnin(generations=5000,tuningInterval=25)
pow_p.run(generations=500)  

### Use stepping-stone sampling to calculate marginal likelihoods
ss = steppingStoneSampler(file="output/pow_Testudines_morphoBodypart.out", powerColumnName="power", likelihoodColumnName="likelihood")
ss.marginal() 

### Use path-sampling to calculate marginal likelihoods
ps = pathSampler(file="output/pow_Testudines_morphoBodypart.out", powerColumnName="power", likelihoodColumnName="likelihood")
ps.marginal() 

# you may want to quit RevBayes now
q()









