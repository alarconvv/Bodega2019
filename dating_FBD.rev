#Read files

taxa <- readTaxonData("data/taxa.tsv")

filenames <- v("data/cytb.nex", "data/cmos.nex" )
filemorpho <- v("data/binary.nex", "data/multistate.nex" ) 

for (i in 1:2){
   datos[i] = readDiscreteCharacterData(filenames[i])
}


for (i in 1:2){
   morpho[i] = readDiscreteCharacterData(filemorpho[i])
}


datos[1].addMissingTaxa( taxa )
datos[2].addMissingTaxa( taxa )
morpho[1].addMissingTaxa( taxa )
morpho[2].addMissingTaxa( taxa )


###Some important Variables
n_taxa <- taxa.size()

#Initial vector to moves and monitors
mvi = 0
mni = 0

#analysis name
analysis_name = "ET"






# useful variables
n_species <- datos[1].ntaxa()
n_branches <- 2 * n_species - 3

########################################################################################################

#									Molecular Partitions

########################################################################################################


#### Sustituton Model

data[1] <- datos[1]
data[1].setCodonPartition( v(1,2) )

data[2] <- datos[1]
data[2].setCodonPartition( 3 )

data[3] <- datos[2]
data[3].setCodonPartition( v(1,2) )

data[4] <- datos[2]
data[4].setCodonPartition( 3 )

# how many partitions?
n_data_subsets <- 4

#### Sustituton Model
for (i in 1:n_data_subsets) {
  er_prior[i] <- v(1,1,1,1,1,1)
  er[i] ~ dnDirichlet(er_prior[i])
  moves[++mvi] = mvBetaSimplex(er[i], alpha=10, tune=true, weight=3)
}

for (i in 1:n_data_subsets) {
  pi_prior[i] <- v(1,1,1,1)
  pi[i] ~ dnDirichlet(pi_prior[i])
  moves[++mvi] = mvBetaSimplex(pi[i], alpha=10, tune=true, weight=2)
}


for (i in 1:n_data_subsets) {
  Q[i] := fnGTR(er[i],pi[i])
}


###### Heterogenity

for (i in 1:n_data_subsets) {
    alpha_prior_mean[i] <- ln(2.0)
    alpha_prior_sd[i] <- 0.587405
    alpha[i] ~ dnLognormal( alpha_prior_mean[i], alpha_prior_sd[i] )
    gamma_rates[i] := fnDiscretizeGamma( alpha[i], alpha[i], 4, false )
    moves[mvi++] = mvScale(alpha[i],lambda=0.1,weight=2)
}


########################################################################################################

#									Branch Length

########################################################################################################


############################################################
# Uncorrelated lognormal model on molecular branch rates #
############################################################



clock_model = "relaxed_lognormal"
branch_rates_mean ~ dnLoguniform(1e-5,10)
moves[mvi++]=mvScale(branch_rates_mean, lambda=0.5, tune=true, weight=1.0) 


branch_rates_sd ~ dnExponential(1/0.578)
moves[mvi++]= mvScale(branch_rates_sd, lambda=0.5, tune=true, weight=1.0) 



# Get the number of branches in the tree #
n_branches <- 2 * n_taxa - 2



for(i in 1:n_branches){
    branch_rates[i] ~ dnLognormal(ln(branch_rates_mean)-(branch_rates_sd^2)/2,branch_rates_sd)
    moves[mvi++] =mvScale(branch_rates[i], lambda=1.0,  weight=1.0) 
    moves[mvi++] =mvScale(branch_rates[i], lambda=0.1,  weight=1.0) 
    moves[mvi++] = mvScale(branch_rates[i], lambda=0.01, weight=1.0) 
    
}


########################################################################################################

#									Topology: FBD Model

########################################################################################################

speciation_rate ~ dnExponential(10)
extinction_rate ~ dnExponential(10)
moves[mvi++] =mvScale(speciation_rate, lambda=0.01, weight=1) 
moves[mvi++] =mvScale(speciation_rate, lambda=0.1,  weight=1) 
moves[mvi++] =mvScale(speciation_rate, lambda=1.0,  weight=1) 


diversification := speciation_rate - extinction_rate
turnover := extinction_rate/speciation_rate

rho <- v(33/336)


psi ~ dnExponential(10) 
moves[mvi++] =mvScale(psi, lambda=0.01, weight=1) 
moves[mvi++] =mvScale(psi, lambda=0.1,  weight=1) 
moves[mvi++] = mvScale(psi, lambda=1,    weight=1) 



origin_time ~ dnUnif(250, 298)

moves[mvi++] =mvSlide(origin_time, delta=0.01, weight=5.0) 
moves[mvi++] =mvSlide(origin_time, delta=0.1,  weight=5.0) 
moves[mvi++] =mvSlide(origin_time, delta=1,    weight=5.0) 


################################# How can I include out_group = clade("Galago_senegalensis")



fbd_dist = dnFBDP(origin=origin_time, lambda=speciation_rate, mu=extinction_rate, phi=psi, r=rho, taxa=taxa)

#Clade Constraints


clade_testudinoidea = clade("Platysternon_megacephalum","Emys_orbicularis","Trachemys_scripta", "Mongolemys_elegans", "Gopherus_polyphemus",
                           "Geoclemys_hamiltonii", "Chelonoidis_chilensis" )


clade_Chelonoidea = clade("Mesodermochelys_undulatus", "Eosphargis_breineri", "Dermochelys_coriacea", "Eretmochelys_imbricata",
                            "Caretta_caretta","Lepidochelys_kempii", "Lepidochelys_olivacea", "Chelonia_mydas", "Natator_depressus",
                            "Eochelone_brabantica","Eochelone_brabantica", "Protostega_gigas", "Ocepechelon_bouyai", "Desmatochelys_lowii",
                            "Rhinochelys_pulchriceps","Santanachelys_gaffneyi" )


clade_Kinosternoidea= clade("Protochelydra_zangerli", "Macrochelys_temminckii", "Chelydra_serpentina", "Emarginachelys_cretacea", "Baptemys_wyomingensis",
                             "Dermatemys_mawii", "Staurotypus_triporcatus", "Sternotherus_odoratus", "Kinosternon_subrubrum", "Kinosternon_flavescens")

clade_Tryonichioidea= clade("Anosteira_ornata","Carettochelys_insculpta","Lissemys_punctata", "Apalone_spinifera","Pelodiscus_sinensis")

clade_cryptodira= clade(clade_Tryonichioidea,clade_Kinosternoidea,"Zangerlia_neimongolensis", "Adocus_beatus", clade_Chelonoidea,clade_testudinoidea)


clade_pleurodira = clade("Erymnochelys_madagascariensis", "Podocnemis_expansa","Pelomedusa_subrufa","Chelus_fimbriata","Phrynops_geoffroanus",
                         "Chelodina_oblonga","Chelodina_longicollis", "Elseya_dentata", "Myuchelys_latisternum")
                         
clade_testudines = clade(clade_cryptodira,clade_pleurodira)



            
constraints = v(clade_Chelonoidea,clade_Kinosternoidea,clade_pleurodira,clade_testudinoidea,clade_Tryonichioidea,clade_cryptodira,clade_testudines)

fbd_tree ~ dnConstrainedTopology(fbd_dist, constraints=constraints)

moves[mvi++] =mvFNPR(fbd_tree, weight=15.0) 
moves[mvi++] =mvCollapseExpandFossilBranch(fbd_tree, origin_time, weight=6.0) 

moves[mvi++] =mvNodeTimeSlideUniform(fbd_tree, weight=40.0) 
moves[mvi++] =mvRootTimeSlideUniform(fbd_tree, origin_time, weight=5.0) 

# Sampling Fossil Occurrence Ages

fossils = fbd_tree.getFossils()
for(i in 1:fossils.size())
{
   t[i] := tmrca(fbd_tree, clade(fossils[i]))

    a_i = fossils[i].getMinAge()
    b_i = fossils[i].getMaxAge()

    F[i] ~ dnUniform(t[i] - b_i, t[i] - a_i)
    F[i].clamp( 0 )
}


moves[mvi++] =mvFossilTimeSlideUniform(fbd_tree, origin_time, weight=5.0) 

num_samp_anc := fbd_tree.numSampledAncestors()

########################################################################################################

#									getting molecular Model

########################################################################################################

for (i in 1:n_data_subsets) {
  phyloSeq[i] ~ dnPhyloCTMC(tree=fbd_tree, Q=Q[i], siteRates=gamma_rates[i], branchRates=branch_rates, type="DNA")
  phyloSeq[i].clamp(data[i])
}


########################################################################################################

#									Morphological Model

########################################################################################################

########################################################################################################
# how many partitions?
n_data_subsets <- 2

#### Sustituton Model


Q_morpho[1] := fnJC(2)
Q_morpho[2] := fnJC(9)


###### Heterogenity



for (i in 1:n_data_subsets) {
alpha_morpho ~ dnExponential( 1.0 )
rates_morpho[i] := fnDiscretizeGamma( alpha_morpho, alpha_morpho, 4 )
moves[mvi++] =mvScale(alpha_morpho, lambda=0.01, weight=5.0) 
moves[mvi++] =mvScale(alpha_morpho, lambda=0.1,  weight=3.0) 
moves[mvi++] =mvScale(alpha_morpho, lambda=1,    weight=1.0) 
}

########################################################################################################

#									Morphological topology

########################################################################################################

#fbd_tree

########################################################################################################

#									Morphology: Branch length

########################################################################################################



clock_morpho_mean ~ dnLoguniform(1e-5,10)
moves[mvi++]=mvScale(clock_morpho_mean, lambda=0.5, tune=true, weight=1.0) 


clock_morpho_sd ~ dnExponential(1/0.578)
moves[mvi++]= mvScale(clock_morpho_sd, lambda=0.5, tune=true, weight=1.0) 



# Get the number of branches in the tree #
n_branches <- 2 * n_taxa - 2



for(i in 1:n_branches){
    clock_morpho[i] ~ dnLognormal(ln(clock_morpho_mean)-(clock_morpho_sd^2)/2,clock_morpho_sd)
    moves[mvi++]=mvScale(clock_morpho[i], lambda=0.5, tune=true, weight=4.0) 
    
}


########################################################################################################

#									getting mophological Model

########################################################################################################


  phyMorpho[1] ~ dnPhyloCTMC(tree=fbd_tree, siteRates=rates_morpho[1], branchRates=clock_morpho, Q=Q_morpho[1],type="Binary")
  phyMorpho[1].clamp(morpho[1])
  
  phyMorpho[2] ~ dnPhyloCTMC(tree=fbd_tree, siteRates=rates_morpho[2], branchRates=clock_morpho[2], Q=Q_morpho[2],type="Standard")
  phyMorpho[2].clamp(morpho[2])



########################################################################################################

#									running Model

########################################################################################################
  
  
mymodel = model(Q)



monitors[mni++] =mnFile(filename="output/testudines_Final2.trees", printgen=10, fbd_tree) 
monitors[mni++] =mnModel(filename="output/testudines_Final2.log", printgen=10) 
monitors[mni++] =mnScreen(printgen=50, num_samp_anc, origin_time,diversification) 
mymcmc = mcmc(mymodel, monitors, moves)
mymcmc.run(generations=10000)

#mymcmc.operatorSummary()

tt = readTreeTrace("output/testudines_final2.trees", "clock")
#tt.summarize()

### write MAP tree to file
mapTree(tt, "output/TimeTree_testudines_final2_mcmc_MAP.tre")

q()

